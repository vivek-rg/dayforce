# OnboardIQ: copy to .env once; never commit .env or real keys.
# Shell environment values override .env. No key or model is needed to run the workflow.

# ACTIVE: each teammate/clone uses its own local SQLite file.
# Confirmed local-demo choice: no cloud database account/URL is required.
# DATABASE_PATH is a file path, NOT a Neon/Supabase/PostgreSQL connection URL.
# Relative paths resolve from the repository root, not the terminal directory.
# Keep this off shared/cloud-sync drives; startup never seeds business hires.
DATABASE_PATH=.runtime/dayone.db

# AI SETTINGS. Defaults below select Groq; add only your matching Groq key privately.
# For another host change LLM_BASE_URL, LLM_MODEL and LLM_API_KEY together.
# AI settings are reread; process/shell overrides can take precedence.
# With incomplete hosted settings, AI is off; all manual workflows still work.
# Create a Groq key at https://console.groq.com/keys; never share it in logs/chat.
# Other values for LLM_PROVIDER: none (AI off), stub (labelled offline rules, not AI),
# ollama (local model; set LLM_MODEL to an installed tag). Keep keys out of VITE_* variables.
LLM_PROVIDER=hosted
LLM_MODEL=openai/gpt-oss-20b
# Local inference endpoint; transport exists, live local-model acceptance is still pending.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Hosted MODEL API endpoint, NOT the OnboardIQ app at http://127.0.0.1:8000.
# The transport appends /chat/completions; do not include that suffix here.
# Never accept this value from a browser or model.
LLM_BASE_URL=https://api.groq.com/openai/v1
# PASTE THE KEY FOR THE SELECTED HOST HERE (Groq with the defaults above).
# Mistral/Gemini compatible endpoints require their own matching base URL and model.
# One provider is active at a time; GEMINI_API_KEY/MISTRAL_API_KEY are not read by this app.
# Alternatives (not live-validated here; use the model available in that account):
# Mistral base: https://api.mistral.ai/v1
# Gemini compatible base: https://generativelanguage.googleapis.com/v1beta/openai
# For Ollama use LLM_PROVIDER=ollama and an installed LLM_MODEL tag; no hosted key.
# For manual-only use LLM_PROVIDER=none; stub is Offline rules, not real AI.
# See README.md for matching provider configuration and evidence limits.
# /api/health (and /health) checks the app/DB, not the model. This app has no
# /v1/models route: a 404 there does NOT establish that a key is missing.
# Point external model discovery at its actual model server, not this app.
# Authenticated /api/health/ai reports configuration only, not a key/inference test.
# This stays on the server. Never commit it.
# Free/trial access, quota, privacy terms and any spend need explicit review.
LLM_API_KEY=
# 1 runs the local background worker with the app. Tests set 0.
WORKER_ENABLED=1
# Total attempted model calls per investigation, persisted across human replies.
MAX_MODEL_CALLS=12
# Total attempted read tools per investigation, persisted across human replies.
MAX_TOOL_CALLS=16
# Per-call wall-clock timeout in seconds, including provider transport failures.
MODEL_TIMEOUT_SECONDS=30
# Total active inference deadline, excluding persisted human waits.
INVESTIGATION_TIMEOUT_SECONDS=90
# Demo password: set privately (at least 12 characters) before seeding.
# No default credential is accepted. Passwords are stored only as salted hashes.
DEMO_PASSWORD=
