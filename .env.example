# DayOne Proof P01: copy to .env once; never commit .env or real keys.
# Only DATABASE_PATH is read by the current application. Everything below
# the future-settings heading is reserved, NOT working authentication/inference.
# Shell environment values override .env. No key/model is needed for P01.

# ACTIVE: each teammate/clone uses its own local SQLite file.
# Confirmed local-demo choice: no cloud database account/URL is required.
# DATABASE_PATH is a file path, NOT a Neon/Supabase/PostgreSQL connection URL.
# Relative paths resolve from the repository root, not the terminal directory.
# Keep this off shared/cloud-sync drives; startup never seeds business hires.
DATABASE_PATH=.runtime/dayone.db

# FUTURE SETTINGS: implement/validate in the named feature phases first.
# P15 will approve keys/config for Groq, Cerebras, Mistral, Gemini and OpenRouter.
# Discovery/selection is not implemented; see docs/PROVIDERS.md.
# Groq offers free-plan access with limits. Key creation does not mean unlimited use.
# Never use VITE_* variables for secrets; never silently switch local to cloud.

# Original adapter-mode placeholder: ollama (local) or hosted (one HTTPS API).
LLM_PROVIDER=ollama
# Placeholder only; no model is downloaded, discovered or validated by P01.
# Use an actually installed local tag (Llama or another model) after P17.
LLM_MODEL=qwen3:8b
# Local inference endpoint, used only by the future Ollama adapter.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Approved HTTPS hosted endpoint; never accept this value from a browser or model.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Original server-only hosted-key placeholder, unused by P01. Leave blank.
# Free/trial access, quota, privacy terms and any spend need explicit review.
LLM_API_KEY=
# Separate LangGraph checkpoint file; application records stay authoritative.
CHECKPOINT_PATH=.runtime/checkpoints.sqlite
# Total attempted model calls per investigation, persisted across human replies.
MAX_MODEL_CALLS=12
# Total attempted read tools per investigation, persisted across human replies.
MAX_TOOL_CALLS=16
# Per-call wall-clock timeout in seconds, including provider transport failures.
MODEL_TIMEOUT_SECONDS=30
# Total active inference deadline, excluding persisted human waits.
INVESTIGATION_TIMEOUT_SECONDS=90
# Future P02/P03 demo password: set privately (at least 12 characters) before seed.
# No default credential is accepted; backend auth is currently a 501 stub.
DEMO_PASSWORD=
