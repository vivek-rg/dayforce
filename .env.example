# OnboardIQ: copy to .env once; never commit .env or real keys.
# Shell environment values override .env. No key or model is needed to run the workflow.

# ACTIVE: each teammate/clone uses its own local SQLite file.
# Confirmed local-demo choice: no cloud database account/URL is required.
# DATABASE_PATH is a file path, NOT a Neon/Supabase/PostgreSQL connection URL.
# Relative paths resolve from the repository root, not the terminal directory.
# Keep this off shared/cloud-sync drives; startup never seeds business hires.
DATABASE_PATH=.runtime/dayone.db

# AI SETTINGS. The app never switches silently from local to cloud.
# Never use VITE_* variables for secrets. Provider discovery is not implemented.
# none   = AI off, all manual workflows still work (default)
# stub   = labelled offline rules for demos and tests, NOT a real AI model
# ollama = local model; LLM_MODEL must be an installed tag
# hosted = one OpenAI-compatible HTTPS API, such as Groq; needs LLM_MODEL and LLM_API_KEY
LLM_PROVIDER=none
# Empty until you choose a model and check its licence and acceptable-use terms.
LLM_MODEL=
# Local inference endpoint, used only by the future Ollama adapter.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Approved HTTPS hosted endpoint; never accept this value from a browser or model.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Server-only hosted key. Leave blank unless you use LLM_PROVIDER=hosted.
# Free/trial access, quota, privacy terms and any spend need explicit review.
LLM_API_KEY=
# 1 runs the local background worker with the app. Tests set 0.
WORKER_ENABLED=1
# Total attempted model calls per investigation, persisted across human replies.
MAX_MODEL_CALLS=12
# Total attempted read tools per investigation, persisted across human replies.
MAX_TOOL_CALLS=16
# Per-call wall-clock timeout in seconds, including provider transport failures.
MODEL_TIMEOUT_SECONDS=30
# Total active inference deadline, excluding persisted human waits.
INVESTIGATION_TIMEOUT_SECONDS=90
# Demo password: set privately (at least 12 characters) before seeding.
# No default credential is accepted. Passwords are stored only as salted hashes.
DEMO_PASSWORD=
