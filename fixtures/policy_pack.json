{
  "id": "NORTHSTAR_ONBOARDING",
  "version": 1,
  "effective_from": "2026-01-01",
  "effective_to": null,
  "scope": {
    "locations": ["HYD-DEMO", "BLR-DEMO"],
    "worker_types": ["employee", "contractor"],
    "roles": ["engineer", "operations_associate", "sales_associate"]
  },
  "sections": [
    { "id": "DOCUMENTS_1", "text": "Fictional policy: a person must verify every identity and employment document before it counts." },
    { "id": "EQUIPMENT_1", "text": "Fictional policy: office equipment handover needs IT confirmation. A reservation is not a handover." },
    { "id": "ACCESS_1", "text": "Fictional policy: account and access requests are recorded by IT. Provisioning here is simulated." },
    { "id": "PAYROLL_1", "text": "Fictional policy: payroll confirms setup after bank and tax forms are submitted. Contractors are invoiced instead." },
    { "id": "BENEFITS_1", "text": "Fictional policy: employees either enrol in benefits or decline. Contractors are not eligible." },
    { "id": "TRAINING_1", "text": "Fictional policy: everyone completes security awareness. Engineers also complete secure coding." },
    { "id": "MANAGER_1", "text": "Fictional policy: the manager assigns a buddy and records first-week goals before the start date." }
  ],
  "rules": [
    { "id": "SUBMIT_ID", "category": "documents", "title": "Submit government ID", "description": "Upload one government-issued ID. Use sample files only in this demo.", "when": {}, "owner_role": "EMPLOYEE", "due_calendar_days_before_start": 7, "depends_on": [], "critical": true, "priority": "HIGH", "required_check": "identity_document_verified", "policy_section_id": "DOCUMENTS_1" },
    { "id": "SUBMIT_EMPLOYMENT", "category": "documents", "title": "Submit signed employment letter", "description": "Upload your signed offer or contract letter.", "when": {}, "owner_role": "EMPLOYEE", "due_calendar_days_before_start": 7, "depends_on": [], "critical": true, "priority": "HIGH", "required_check": "employment_document_verified", "policy_section_id": "DOCUMENTS_1" },
    { "id": "CONFIRM_LOCATION", "category": "documents", "title": "Confirm work location against the letter", "description": "HR confirms that the profile location matches the signed letter.", "when": {}, "owner_role": "HR", "due_calendar_days_before_start": 5, "depends_on": ["SUBMIT_EMPLOYMENT"], "critical": true, "priority": "HIGH", "required_check": "profile_location_confirmed", "policy_section_id": "DOCUMENTS_1" },
    { "id": "RESERVE_DEVICE", "category": "equipment", "title": "Reserve a laptop", "description": "Request a laptop at the approved location. IT approves the exact device.", "when": { "work_mode": "office" }, "owner_role": "IT", "due_calendar_days_before_start": 3, "depends_on": ["CONFIRM_LOCATION"], "critical": false, "priority": "HIGH", "policy_section_id": "EQUIPMENT_1" },
    { "id": "HANDOVER", "category": "equipment", "title": "Record equipment handover", "description": "Record the handover only once the person actually has the device.", "when": { "work_mode": "office" }, "owner_role": "IT", "due_calendar_days_before_start": 0, "depends_on": ["RESERVE_DEVICE"], "critical": true, "priority": "HIGH", "required_check": "device_handover_recorded", "policy_section_id": "EQUIPMENT_1" },
    { "id": "SHIP_DEVICE", "category": "equipment", "title": "Ship a laptop to the remote employee", "description": "Reserve a device, ship it and record handover on delivery.", "when": { "work_mode": "remote" }, "owner_role": "IT", "due_calendar_days_before_start": 2, "depends_on": ["CONFIRM_LOCATION"], "critical": true, "priority": "HIGH", "required_check": "device_handover_recorded", "policy_section_id": "EQUIPMENT_1" },
    { "id": "BADGE_BLR", "category": "equipment", "title": "Issue Bengaluru office badge", "description": "Collect from the Bengaluru reception on day one.", "when": { "location_id": "BLR-DEMO", "work_mode": "office" }, "owner_role": "IT", "due_calendar_days_before_start": 0, "depends_on": [], "critical": false, "priority": "LOW", "policy_section_id": "EQUIPMENT_1" },
    { "id": "BADGE_HYD", "category": "equipment", "title": "Issue Hyderabad office badge", "description": "Collect from the Hyderabad reception on day one.", "when": { "location_id": "HYD-DEMO", "work_mode": "office" }, "owner_role": "IT", "due_calendar_days_before_start": 0, "depends_on": [], "critical": false, "priority": "LOW", "policy_section_id": "EQUIPMENT_1" },
    { "id": "ACCOUNT_EMAIL", "category": "it_access", "title": "Create corporate email (simulated)", "description": "Simulated account request. No real system is contacted.", "when": {}, "owner_role": "IT", "due_calendar_days_before_start": 3, "depends_on": [], "critical": true, "priority": "HIGH", "required_check": "it_access_provisioned", "policy_section_id": "ACCESS_1", "creates_source": { "category": "it_access", "key": "email", "payload": { "category": "it_access", "item": "CORPORATE_EMAIL", "detail": "", "state": "REQUESTED", "simulated": true } } },
    { "id": "ACCESS_VPN", "category": "it_access", "title": "Grant VPN and developer tools (simulated)", "description": "Simulated request for engineering tools.", "when": { "role": "engineer" }, "owner_role": "IT", "due_calendar_days_before_start": 1, "depends_on": ["ACCOUNT_EMAIL"], "critical": false, "priority": "MEDIUM", "required_check": "it_access_provisioned", "policy_section_id": "ACCESS_1", "creates_source": { "category": "it_access", "key": "vpn", "payload": { "category": "it_access", "item": "VPN", "detail": "Developer tools", "state": "REQUESTED", "simulated": true } } },
    { "id": "ACCESS_CRM", "category": "it_access", "title": "Grant CRM access (simulated)", "description": "Simulated request for sales tools.", "when": { "role": "sales_associate" }, "owner_role": "IT", "due_calendar_days_before_start": 1, "depends_on": ["ACCOUNT_EMAIL"], "critical": false, "priority": "MEDIUM", "required_check": "it_access_provisioned", "policy_section_id": "ACCESS_1", "creates_source": { "category": "it_access", "key": "crm", "payload": { "category": "it_access", "item": "APPLICATION_ACCESS", "detail": "CRM", "state": "REQUESTED", "simulated": true } } },
    { "id": "PAYROLL_SETUP", "category": "payroll", "title": "Confirm payroll setup", "description": "Track bank and tax form submission, then confirm setup. No account numbers are stored.", "when": { "worker_type": "employee" }, "owner_role": "PAYROLL", "due_calendar_days_before_start": -5, "depends_on": [], "critical": true, "priority": "HIGH", "required_check": "payroll_setup_confirmed", "policy_section_id": "PAYROLL_1", "creates_source": { "category": "payroll", "payload": { "category": "payroll", "profile_created": false, "setup_confirmed": false, "bank_submitted": false, "tax_submitted": false } } },
    { "id": "BENEFITS_ENROL", "category": "benefits", "title": "Complete benefits enrolment", "description": "Invite the employee, then record enrolment or decline.", "when": { "worker_type": "employee" }, "owner_role": "BENEFITS", "due_calendar_days_before_start": -7, "depends_on": [], "critical": false, "priority": "MEDIUM", "required_check": "benefits_resolved", "policy_section_id": "BENEFITS_1", "creates_source": { "category": "benefits", "payload": { "category": "benefits", "state": "NOT_INVITED" } } },
    { "id": "TRAIN_SECURITY", "category": "training", "title": "Complete security awareness training", "description": "Required for everyone in the first week.", "when": {}, "owner_role": "TRAINING", "due_calendar_days_before_start": -3, "depends_on": [], "critical": true, "priority": "MEDIUM", "required_check": "training_completed", "policy_section_id": "TRAINING_1", "creates_source": { "category": "training", "key": "security", "payload": { "category": "training", "course_id": "SECURITY_AWARENESS", "state": "ASSIGNED" } } },
    { "id": "TRAIN_CODING", "category": "training", "title": "Complete secure coding training", "description": "Required for engineers.", "when": { "role": "engineer" }, "owner_role": "TRAINING", "due_calendar_days_before_start": -10, "depends_on": ["TRAIN_SECURITY"], "critical": false, "priority": "MEDIUM", "required_check": "training_completed", "policy_section_id": "TRAINING_1", "creates_source": { "category": "training", "key": "coding", "payload": { "category": "training", "course_id": "SECURE_CODING", "state": "ASSIGNED" } } },
    { "id": "MANAGER_PLAN", "category": "manager", "title": "Assign a buddy and first-week goals", "description": "Record the buddy and first-week plan before the start date.", "when": {}, "owner_role": "MANAGER", "due_calendar_days_before_start": 2, "depends_on": [], "critical": true, "priority": "HIGH", "required_check": "manager_plan_recorded", "policy_section_id": "MANAGER_1" },
    { "id": "MANAGER_INTRO", "category": "manager", "title": "Schedule team introductions", "description": "Book introductions for the first week.", "when": {}, "owner_role": "MANAGER", "due_calendar_days_before_start": 1, "depends_on": [], "critical": false, "priority": "LOW", "policy_section_id": "MANAGER_1" }
  ]
}
